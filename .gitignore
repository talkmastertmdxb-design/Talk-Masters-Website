# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# allow the documented env template
!.env.example

# playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# locally installed agent skills: symlinks hold absolute paths; reinstall from skills-lock.json
/.claude/skills/

# Design references: animation templates and demos (third-party, unknown licence; not used by the site)
/design-references/

# Launch videos made with /brag-slim (rendered output and working files)
/brag-output*/
.DS_Store

# Original photo uploads (copied into public/images with clean names)
/src/*.jpeg

# Raw, uncompressed video. Compressed cuts live in public/videos (see docs/IMAGES.md).
/assets/source/video/


# raw event photo dumps: originals stay off git, the chosen ones live in public/images/events
/she LEADS/
/Career Nova 2025-29-Jun-25/
/TM Session 13-Jul-2025/
/TM Session 80- 10-Aug-2025- All/
