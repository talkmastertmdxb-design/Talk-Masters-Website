# Copy to .env.local. Never commit real values.

# Public base URL, used for metadata, sitemap and Open Graph images
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to "true" on preview deployments to show photo briefs on image placeholders
NEXT_PUBLIC_SHOW_PLACEHOLDER_LABELS=

# Phase 6 (guest-visit form), server-only:
# RESEND_API_KEY=
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# GOOGLE_SERVICE_ACCOUNT_JSON=
# GUEST_SHEET_ID=
